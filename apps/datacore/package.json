{
  "name": "datacore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/solvers/sandbox-runner.mjs','dist/solvers/sandbox-runner.mjs')\" && node -e \"const fs=require('fs'),p='src/synthetic/packs',d='dist/synthetic/packs';if(fs.existsSync(p)){fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(p))if(f.endsWith('.pack.json'))fs.copyFileSync(p+'/'+f,d+'/'+f)}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate-cli.js",
    "seed": "node dist/seed-cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.0",
    "@platform/contracts": "workspace:*",
    "@platform/llm-adapters": "workspace:*",
    "argon2": "^0.41.1",
    "cron-parser": "^5.5.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "node-xlsx": "^0.24.0",
    "openai": "^6.42.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
