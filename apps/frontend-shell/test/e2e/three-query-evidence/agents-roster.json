mcp_builtin_solvers"},{"mcpConfigId":"mcp_builtin_workflow"}],"scopeDeclaration":{"objectTypes":["Base","Order","Model","Line","Process"],"toolNames":["mcp__builtin__query_objects","mcp__solvers__risk_timeline","mcp__solvers__gap_attribution","mcp__solvers__affected_orders","mcp__solvers__base_capacity_outlook","evaluate_rules","mcp__workflow__risk_digest"]},"budget":{"maxIterations":8,"maxToolCalls":10},"status":"DRAFT","kernel":"EXTERNAL"},{"id":"agt_capacity_planner","tenantId":"demo","key":"capacity_planner","version":1,"name":"产能规划 Agent","description":"型号需求增量可行性评估与产能排程建议","model":"","systemPrompt":"【角色】你是产能规划专家，服务电池制造场景，代表产能/产线/工序瓶颈的生产视角。\n【目标】你要产出需求增量可行性判断与排程/外协建议（决策级结论，不是罗列数据）。\n【对象域】你只在 Base/Line/Model/Order 对象域内取证（越界会被拒）。\n【对口能力】优先调用 invoke_solver（产能校核/可行性）；涉及排产/优化必须调 solver，不自己算。\n【交卷】按 结论/分析/证据/建议/风险 组织，业务数字一律 ⟦ref:N⟧。","tools":[{"kind":"MCP","mcpConfigId":"mcp_builtin_tools","toolFilter":["mcp__builtin__query_objects"]},{"kind":"MCP","mcpConfigId":"mcp_builtin_solvers","toolFilter":["mcp__solvers__capacity_forecast","mcp__solvers__mrp_netting","mcp__solvers__affected_orders","mcp__solvers__bottleneck_matrix","mcp__solvers__base_capacity_outlook"]},{"kind":"MCP","mcpConfigId":"mcp_builtin_ontology","toolFilter":["mcp__ontology__plan_slice","mcp__ontology__resolve_slice"]},{"kind":"MCP","mcpConfigId":"mcp_builtin_workflow","toolFilter":["mcp__workflow__capacity_check"]}],"ruleBindings":{"ruleKeys":"ALL_APPLICABLE","mode":"POST_CHECK"},"skills":[{"skillId":"skl_seed_capacity","version":"latest"}],"mcpServers":[{"mcpConfigId":"mcp_builtin_ontology"},{"mcpConfigId":"mcp_builtin_solvers"},{"mcpConfigId":"mcp_builtin_workflow"},{"mcpConfigId":"mcp_builtin_tools"}],"scopeDeclaration":{"objectTypes":["Base","Line","Model","Order"],"toolNames":["mcp__builtin__query_objects","mcp__solvers__capacity_forecast","mcp__solvers__mrp_netting","mcp__solvers__affected_orders","mcp__solvers__bottleneck_matrix","mcp__solvers__base_capacity_outlook","mcp__ontology__plan_slice