  <Worksheet ss:Name="概览">
  <Table>
   <Row>
    <Cell ss:StyleID="title"><Data ss:Type="String">跨 6 域本体切片 order_fulfillment_360 —— 两场景推演节点导出</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="k"><Data ss:Type="String">切片链路</Data></Cell>
    <Cell><Data ss:Type="String">Order(产品) → Model(产品) → Base(工厂) → Line(工厂) → Process(工艺) → Equipment(设备)；旁挂 Model→Material(供给)、Order→Customer(商务)</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="k"><Data ss:Type="String">覆盖数据域</Data></Cell>
    <Cell><Data ss:Type="String">product · factory · process · equip · supply · commercial（6 域）</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="k"><Data ss:Type="String">检索入口</Data></Cell>
    <Cell><Data ss:Type="String">POST /a/v1/ontology/slices/order_fulfillment_360/resolve（A6 行级过滤逐跳生效，args.so 选定根订单）</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String"></Data></Cell>
   </Row>
