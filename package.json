{
  "name": "ontology-decision-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "chain:check": "node scripts/check-chain-closure.mjs",
    "gates": "node scripts/check-system-ontology.mjs && node scripts/check-chain-closure.mjs",
    "lint": "pnpm -r lint",
    "ontology:check": "node scripts/check-system-ontology.mjs",
    "parity": "node scripts/parity-audit.mjs",
