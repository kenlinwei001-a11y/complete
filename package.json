{
  "name": "ontology-decision-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "chain:check": "node scripts/check-chain-closure.mjs",
    "debattery:check": "node scripts/check-debattery.mjs",
    "prd:check": "node scripts/check-prd-ontology.mjs",
    "prd:coverage": "node scripts/check-prd-coverage.mjs",
    "meta:sync": "node scripts/check-meta-sync.mjs",
    "bstack-derive:check": "node scripts/check-bstack-derive.mjs",
    "modeling-wire:check": "node scripts/check-modeling-wire.mjs",
    "link-stabilize:check": "node scripts/check-link-stabilize.mjs",
    "ontology-slice-coverage:check": "node scripts/check-ontology-slice-coverage.mjs",
    "slice-connectivity:check": "node scripts/check-slice-connectivity.mjs",
    "resource-descriptor:check": "node scripts/check-resource-descriptor.mjs",
    "dril-registry:check": "node scripts/check-dril-registry.mjs",
    "dril-retrieval:check": "node scripts/check-dril-retrieval.mjs",
    "dril-quality:check": "node scripts/check-dril-quality.mjs",
    "loop-control:check": "node scripts/check-loop-control.mjs",
    "gates": "node scripts/check-system-ontology.mjs && node scripts/check-chain-closure.mjs && node scripts/check-debattery.mjs && node scripts/check-prd-ontology.mjs && node scripts/check-prd-coverage.mjs && node scripts/check-meta-sync.mjs && node scripts/check-resource-descriptor.mjs && node scripts/check-ontology-slice-coverage.mjs && node scripts/check-slice-connectivity.mjs && node scripts/check-loop-control.mjs",
    "lint": "pnpm -r lint",
    "ontology:check": "node scripts/check-system-ontology.mjs",
    "parity": "node scripts/parity-audit.mjs",
    "provision:enterprise": "node scripts/provision-enterprise.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "global-agent": "^4.1.3",
    "https-proxy-agent": "^9.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.2.6"
  }
}
