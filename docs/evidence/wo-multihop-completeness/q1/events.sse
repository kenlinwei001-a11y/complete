lId":"tc_01M4JQS6TR4DDWJ6P5BGMA9Z9B","toolName":"mcp__solvers__quote_margin","outputPath":"data.scope.unitBasis"},{"id":"prov_01M4JQT978W0HJK0Z87SKHFAE4","source":"TOOL_RESULT","toolCallId":"tc_01M4JQSD3H1SJBVZVMGMAN460M","toolName":"mcp__solvers__generic_inference","outputPath":"data.dataMode"}],"unverifiedNumerics":true,"stats":{"sessionStats":{"turns":1,"steps":5,"llmMs":44646,"toolMs":2945,"ttftMs":4422,"ttftSteps":5,"decodeMs":40224,"decodeTokens":9976},"tokenUsage":{"uncachedInputTokens":13255,"outputTokens":9976,"cacheReadTokens":189824,"cacheWriteTokens":0},"contextPressure":{"pressureTokens":48030}}}

