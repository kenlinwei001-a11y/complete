# deps & build
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/

# env & secrets
.env
.env.*
!.env.example

# runtime data
.blobstore/
.blobs/
blobs/
*.log

# OS / editor
.DS_Store
*.swp

# local-only Claude config
.claude/settings.local.json

# 大体积生成物（按需用 Git LFS；默认不入库）
deliverables/
db-seed/*.sql
!db-seed/agentcore-seed.sql
.claude/worktrees/

# reviewer-side cron (durable) — must NOT leak to dev session
.claude/scheduled_tasks.json

# reviewer/agent transient browser-scan & FDE verify scripts
# (must sit at repo root for playwright-core ESM resolution; created→run→deleted)
/.scan-*.mjs
/.verify-*.mjs
/.recon-*.mjs
/.probe-*.mjs
/.fde-*.mjs
# dev/agent 瞬态 FDE 验证脚本工作区（curl e2e helper；权威证据落 test/*.test.ts，非交付物）
/scratchpad/
